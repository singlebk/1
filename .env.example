# ==========================================
# KPN Platform Environment Variables Template
# ==========================================
# Copy this file to '.env' and fill in the values with your actual secrets.
# Do NOT commit your actual '.env' file to version control.

# ------------------------------------------
# Django Core Settings
# ------------------------------------------
SESSION_SECRET=your_super_secret_django_key_here
DEBUG=False
SITE_URL=http://localhost:8000

# ------------------------------------------
# Deployment & Hosting
# ------------------------------------------
RENDER_EXTERNAL_HOSTNAME=your_render_hostname
REPLIT_DOMAINS=your_replit_domain.repl.co

# ------------------------------------------
# Security
# ------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/kpn_db

# ------------------------------------------
# Storage & Media (Cloudinary)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------
# Email Service (SMTP/Django default)
# ------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=noreply@kpn.com.ng

# ------------------------------------------
# Lockally (Alternative Email/Auth Service)
# ------------------------------------------
LOCKALLY_API_KEY=your_lockally_api_key
LOCKALLY_API_URL=https://api.lockally.com/v1
LOCKALLY_FROM_EMAIL=noreply@kpn.com.ng
LOCKALLY_FROM_NAME=KPN - Kebbi Progressive Network

# ------------------------------------------
# Telegram Integration
# ------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=KPNKebbiBot
TELEGRAM_CHANNEL_ID=-1002364023770
TELEGRAM_WEBHOOK_SECRET=generate_a_random_webhook_secret

# ------------------------------------------
# AI Provider Configuration
# ------------------------------------------
# 
# KPN supports multiple AI providers. The system tries each provider in order
# until one succeeds. This makes the architecture provider-agnostic — you can
# switch providers, add API keys, or reconfigure without changing any code.
#
# There are TWO ways to configure providers:
#
#   1. Environment Variables (below) — for simple setups or legacy config.
#   2. Django Admin → Telegram Integration → AI Providers — for full control,
#      including OpenAI-compatible providers, priority ordering, and the
#      "Test Connection" button (recommended for production use).
#
# ── Method 1: ENV-var based providers ──────────────────────────────────────
# Comma-separated list of built-in provider IDs to use as fallback:
AI_PROVIDERS=openrouter,google

# OpenRouter — routes to hundreds of models via a single OpenAI-compatible API
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Google AI (Gemini) — direct Gemini API access (free tier available)
GOOGLE_AI_API_KEY=your_google_ai_api_key

# ── Method 2: Admin-configured providers (OpenAI-compatible) ──────────────
# Configure additional providers directly in Django Admin without ENV vars.
# Any provider that exposes an OpenAI-compatible /v1/chat/completions endpoint
# can be added this way, including:
#
#   Provider      | Base URL
#   ------------- | --------------------------------------------------
#   OpenAI        | https://api.openai.com/v1
#   Groq          | https://api.groq.com/openai/v1
#   DeepSeek      | https://api.deepseek.com/v1
#   Mistral       | https://api.mistral.ai/v1
#   Together AI   | https://api.together.xyz/v1
#   Qwen/Alibaba  | https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Perplexity    | https://api.perplexity.ai
#   Fireworks     | https://api.fireworks.ai/inference/v1
#   Self-hosted   | http://localhost:11434/v1  (Ollama example)
#
# To add any of these:
#   1. Go to Django Admin → Telegram Integration → AI Providers → Add AI Provider
#   2. Set: Name, Protocol (OpenAI Compatible), Base URL, API Key, Model
#   3. Set order (lower = higher priority)
#   4. Click "Test" to verify the connection
#   5. Click "Save"
#
# Admin-configured providers are tried BEFORE ENV-var providers.

# ── AI Rate Limiting ────────────────────────────────────────────────────────
AI_MAX_REQUESTS_PER_HOUR=20
AI_MAX_REQUESTS_PER_DAY=100
